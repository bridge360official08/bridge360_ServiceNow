# Bridge360 Environment Configuration Example
# Copy this file to .env and fill in your own credentials/endpoints.

# Gemini API Key (for local AI assistant features)
VITE_GEMINI_API_KEY=REPLACE_WITH_YOUR_GEMINI_API_KEY

# EasyOCR Microservice endpoint (default points to local Vite proxy)
VITE_EASYOCR_URL=/api/easyocr/ocr

# ServiceNow instance base URL (used by the browser client on non-dev hosts)
VITE_SN_INSTANCE_URL=https://your-instance.service-now.com

# Local-dev ONLY: Basic-auth credential (format "user:pass") the browser client
# uses to reach the proxied ServiceNow instance during `npm run dev`.
# Prefer a dedicated least-privilege integration user, NOT the admin account.
# This is never bundled into production builds.
VITE_SN_BASIC_AUTH=your_sn_user:your_sn_password

# Node data/admin scripts (scripts/*.mjs) read this instead of VITE_SN_BASIC_AUTH.
SN_BASIC_AUTH=your_sn_user:your_sn_password
